{
  "name": "Cuentas Claras",
  "short_name": "Cuentas Claras",
  "description": "Control de gastos personales: extractos del banco, efectivo y presupuesto.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2321",
  "theme_color": "#1d2321",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?compartir=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "extracto",
          "accept": [
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv",
            "text/plain",
            ".txt",
            ".n43",
            ".q43",
            ".aeb",
            ".c43",
            "application/vnd.ms-excel",
            ".xls",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
