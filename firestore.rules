rules_version = '2';
// Reglas de Firestore para Mis gastos.
// Sustituye CORREO_DEL_ADMINISTRADOR por el correo del administrador antes de publicarlas
// (Firebase → Firestore Database → Reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'CORREO_DEL_ADMINISTRADOR'
        && request.auth.token.email_verified == true;
    }

    function activo(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.activo == true;
    }

    // Buzón de sugerencias: cada persona envía y ve solo las suyas; el administrador las ve todas y las gestiona.
    match /sugerencias/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'tipo', 'texto', 'version', 'dispositivo', 'fecha', 'estado'])
        && request.resource.data.estado == 'nueva'
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000;
      allow read: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Perfil de cada usuario: lo lee el propio usuario; solo el administrador lo crea o cambia.
    match /users/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      // Solicitud de acceso: el propio usuario crea su perfil, siempre inactivo y pendiente.
      allow create: if esAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'activo', 'rol', 'estado', 'creado'])
        && request.resource.data.activo == false
        && request.resource.data.rol == 'usuario'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80);
      // Cada usuario solo puede actualizar su fecha de último acceso; el resto, el administrador.
      allow update: if esAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso']));
      allow delete: if esAdmin();

      // Datos (movimientos, ajustes): solo el propio usuario, y solo si su cuenta está activa.
      // El administrador NO tiene acceso a los datos de los demás.
      match /{resto=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid && activo(uid);
        // El administrador solo puede BORRAR (al eliminar un usuario), nunca leer.
        allow delete: if esAdmin();
      }
    }
  }
}
