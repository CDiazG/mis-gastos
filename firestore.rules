rules_version = '2';
// Reglas de Firestore para Mis gastos.
// Sustituye CORREO_DEL_ADMINISTRADOR por el correo del administrador antes de publicarlas
// (Firebase → Firestore Database → Reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'CORREO_DEL_ADMINISTRADOR'
        && request.auth.token.email_verified == true;
    }

    function activo(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.activo == true;
    }

    // Buzón de sugerencias: cada persona envía y ve solo las suyas; el administrador las ve todas y las gestiona.
    match /sugerencias/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'tipo', 'texto', 'version', 'dispositivo', 'fecha', 'estado'])
        && request.resource.data.estado == 'nueva'
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000;
      allow read: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Registro de errores: cada usuario anota los suyos; solo el administrador los lee y borra.
    match /errores/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'tipo', 'mensaje', 'detalle', 'version', 'dispositivo', 'fecha'])
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 1000;
      allow read, delete: if esAdmin();
    }

    // Chat con el administrador: cada conversación es de un usuario; solo la ven él y el administrador.
    match /mensajes/{id} {
      allow read: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'de', 'texto', 'fecha', 'leido'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.leido == false
        && ((request.resource.data.uid == request.auth.uid && request.resource.data.de == 'usuario' && activo(request.auth.uid))
          || (esAdmin() && request.resource.data.de == 'admin'));
      allow update: if (esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
      allow delete: if esAdmin();
    }

    // Si el administrador está en línea (él decide si se muestra)
    match /presencia/{id} {
      allow read: if request.auth != null && activo(request.auth.uid);
      allow write: if esAdmin();
    }

    // Foro: lo leen y escriben los usuarios activos; cada uno borra lo suyo y el administrador, todo.
    match /foro/{id} {
      allow read: if request.auth != null && activo(request.auth.uid);
      allow create: if request.auth != null && activo(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'titulo', 'texto', 'hilo', 'fecha'])
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 3000
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120;
      allow delete: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Nombre y foto que ven los demás usuarios (en el foro). Nada de datos de cuentas.
    match /perfiles/{uid} {
      allow read: if request.auth != null && activo(request.auth.uid);
      allow create, update: if request.auth != null && request.auth.uid == uid && activo(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'foto'])
        && request.resource.data.foto is string && request.resource.data.foto.size() < 60000;
      allow delete: if esAdmin();
    }

    // Perfil de cada usuario: lo lee el propio usuario; solo el administrador lo crea o cambia.
    match /users/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      // Solicitud de acceso: el propio usuario crea su perfil, siempre inactivo y pendiente.
      allow create: if esAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'activo', 'rol', 'estado', 'creado'])
        && request.resource.data.activo == false
        && request.resource.data.rol == 'usuario'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80);
      // Cada usuario solo puede actualizar su último acceso, su foto y su nombre; el resto, el administrador.
      allow update: if esAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso', 'foto', 'nombre'])
        && (!('foto' in request.resource.data) || request.resource.data.foto.size() < 60000)
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80);
      allow delete: if esAdmin();

      // Datos (movimientos, ajustes): solo el propio usuario, y solo si su cuenta está activa.
      // El administrador NO tiene acceso a los datos de los demás.
      match /{resto=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid && activo(uid);
        // El administrador solo puede BORRAR (al eliminar un usuario), nunca leer.
        allow delete: if esAdmin();
      }
    }
  }
}
